{% extends "base.html.jinja2" %}

{% block content %}
{% if sources %}

    <div>
        <table class="table">
            <tr>
                <td>
                    <div id="gene_variant" class="d-flex justify-content-center h2" data-bs-toggle="modal" data-bs-target="#variantModal">  
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="sr-only"></span>
                        </div>
                    </div>
                </td>
                <td>
                    <div id="transcript_variant" class="d-flex justify-content-center h2" data-bs-toggle="modal" data-bs-target="#variantModal">  
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="sr-only"></span>
                        </div>
                    </div>
                </td>
                <td>
                    <div id="cdot_variant" class="d-flex justify-content-center h2" data-bs-toggle="modal" data-bs-target="#variantModal">  
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="sr-only"></span>
                        </div>
                    </div>
                </td>
                <td>
                    <div id="pdot_variant" class="d-flex justify-content-center h2 text-end" data-bs-toggle="modal" data-bs-target="#variantModal">  
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="sr-only"></span>
                        </div>
                    </div>
                </td>
                <td>
                    <div id="gdot_variant" class="d-flex justify-content-center h2 text-break" data-bs-toggle="modal" data-bs-target="#variantModal">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="sr-only"></span>
                        </div>
                    </div>
                </td>
            </tr>
        </table>
    </div>
{% else %}
<h6 class="text-center">Search Something for results</h2>
{% endif %}
    {% macro loading_card(source) %}
                <div class="card" >
                    <div class="card-body">
                        <h5 class="card-title">{{ source.name }}</h5>
                        <h6 class="card-subtitle mb-2 text-muted">Loading...</h6>
                        <div class="d-flex justify-content-center" data-source-loading="{{ source.__class__.__name__ }}">
                            <div class="spinner-border text-primary" role="status">

                            </div>
                        </div>
                    </div>
                    <div class="card-footer">

                    </div>
                </div>
    {% endmacro %}
    <div class="row row-cols-1 row-cols-md-3 g-4">
        {% set stack = namespace(shown=false) %}
        {% for source in sources %}
            {% if source in stacked_sources %}
                {# the stacked sources share one column, they are all put at the place of the first of them #}
                {% if not stack.shown %}
                    {% set stack.shown = true %}
                    <div class="col">
                        <div class="d-flex flex-column gap-4 h-100">
                            {% for stacked_source in stacked_sources %}
                                <div class="flex-fill {% if stacked_source.is_hidden() %}d-none{% endif %}" id="{{ stacked_source.__class__.__name__ }}_div">
                                    {{ loading_card(stacked_source) }}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <div class="col {% if source.is_hidden() %}d-none{% endif %} {% if source.is_banner() %}w-100 d-none{% endif %}" id="{{ source.__class__.__name__ }}_div" {% if source.is_banner() %}data-banner{% endif %}>
                    {{ loading_card(source) }}
                </div>
            {% endif %}
        {% endfor %}
    </div>
    <input type="hidden" id="ws_url" value="{{ websocket_url }}" />

<div class="modal fade" id="variantModal" tabindex="-1" aria-labelledby="variantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="variantModalLabel">Variant Data</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-header text-center h5" id="new_search_link_div">
                -
            </div>
            <div  id="variant-data-div" class="modal-body row row-cols-3">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<template id="variant-data-template">
    <div class="col m-2">
        <table class="table caption-top">
            <caption></caption>
            <tbody>
            </tbody>
        </table>
    </div>
</template>


{% endblock %}
{% block js_import %}
    <script src="{{ url_for('static', path='/molclass.js') }}?v={{ static_version }}"></script> 
{% endblock %}